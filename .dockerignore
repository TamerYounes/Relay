# Dependencies and build output (rebuilt inside the image)
node_modules
.next
out
build
coverage
*.tsbuildinfo

# Secrets: env files are passed at runtime, never copied into the image
.env*
*.pem

# VCS, editor and tooling
.git
.gitignore
.vscode
.idea
.claude
.vercel
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker files and docs aren't needed in the build context
Dockerfile
.dockerignore
docker-compose*.yml
*.md
